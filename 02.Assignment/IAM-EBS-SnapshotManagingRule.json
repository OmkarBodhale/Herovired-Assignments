{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowDescribeSnapshots",
            "Effect": "Allow",
            "Action": "ec2:DescribeSnapshots",
            "Resource": "*"
        },
        {
            "Sid": "AllowCreateSnapshotForSpecificVolume",
            "Effect": "Allow",
            "Action": "ec2:CreateSnapshot",
            "Resource": [
                "arn:aws:ec2:REGION:ACCOUNT_ID:volume/YOUR_VOLUME_ID",
                "arn:aws:ec2:REGION:ACCOUNT_ID:snapshot/*"
            ]
        },
        {
            "Sid": "AllowTaggingOnCreation",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:snapshot/*",
            "Condition": {
                "StringEquals": {
                    "ec2:CreateAction": "CreateSnapshot"
                }
            }
        },
        {
            "Sid": "AllowDeletingOnlyLambdaSnapshots",
            "Effect": "Allow",
            "Action": "ec2:DeleteSnapshot",
            "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:snapshot/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/CreatedBy": "Lambda-Backup"
                }
            }
        }
    ]
}
